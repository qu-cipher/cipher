import { ComboBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { AppState, ConnectionState } from "../state.slint";
import { PillButton, ProtocolBadge } from "../components/buttons.slint";
import { TabBar } from "../components/tab-bar.slint";

// One direction of the traffic box: speed, and the total below it.
component TrafficStat inherits HorizontalLayout {
    in property <image> icon;
    in property <color> tint;
    in property <string> label;
    in property <string> speed;
    in property <string> total;
    in property <bool> live;
    spacing: 8px;

    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 24px;
            height: 24px;
            border-radius: 12px;
            background: root.tint.transparentize(root.live ? 82% : 92%);

            Image {
                source: root.icon;
                width: 14px;
                height: 14px;
                colorize: root.live ? root.tint : Theme.text-faint;
            }
        }
    }

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;

        Text {
            text: root.live ? root.speed : "—";
            font-size: 13px;
            font-weight: 700;
            color: root.live ? Theme.text : Theme.text-faint;
            overflow: elide;
        }

        Text {
            text: root.live ? root.total + " total" : root.label;
            font-size: 10px;
            color: Theme.text-muted;
            overflow: elide;
        }
    }
}

export component ConnectPanel inherits Rectangle {
    // The power button's diameter.
    in property <length> size: 128px;
    // Offer the System proxy mode (desktop only).
    in property <bool> system-proxy: true;
    // Pulling down anywhere on the panel connects / disconnects (phones).
    in property <bool> pull;

    // The selected-config card was clicked.
    callback open-configs();

    background: Theme.panel;

    private property <ConnectionState> state: AppState.connection;
    private property <bool> connected: state == ConnectionState.connected;
    private property <bool> busy: state == ConnectionState.connecting || state == ConnectionState.disconnecting;
    private property <color> tint: connected ? Theme.connected : busy ? Theme.connecting : Theme.idle;
    // The ring's color: the accent invites a click while idle.
    private property <color> ring-color: connected || busy ? tint : touch.has-hover ? Theme.accent : Theme.border-strong;
    // 0..1 breathing value; only ticks while busy so an idle window doesn't keep redrawing.
    private property <float> wave: busy ? (1 + sin(animation-tick() / 1.4s * 360deg)) / 2 : 0;
    // Connecting can be cancelled; disconnecting can't.
    private property <bool> can-toggle: state != ConnectionState.disconnecting && !AppState.cancelling;

    // ── Pull to connect ──
    // How far down a finger travels to close the circle.
    private property <length> pull-distance: 180px;
    // 0..1: the arc drawn around the button; follows the finger, unwinds when let go early.
    private property <float> progress;
    animate progress { duration: root.pulling ? 0ms : 200ms; easing: ease-out; }
    // A pull is under way (past a small dead zone, not yet completed).
    private property <bool> pulling;
    // This pull closed the circle and toggled; nothing more until the finger lifts.
    private property <bool> pulled;
    // The finger moved since it went down: the button's tap doesn't count then.
    private property <bool> dragged;
    // 0..1: how much the button has grown; follows the pull, settles back once it ends.
    private property <float> grow: root.pulling ? 0.3 + 0.7 * root.progress : 0;
    animate grow { duration: root.pulling ? 60ms : 200ms; easing: ease-out; }
    // The button's diameter: up to 14% bigger; the disc and the icon inside it grow more.
    private property <length> disc: root.size * (1 + 0.14 * root.grow);
    // 0..1: the disc sinks in while the button is held for a tap.
    private property <float> press: touch.pressed && !root.dragged ? 1 : 0;
    animate press { duration: 80ms; easing: ease-in-out; }

    function pull-start() {
        root.pulled = false;
        root.dragged = false;
    }

    function pull-to(dy: length) {
        if dy > 8px {
            root.dragged = true;
        }
        if !root.pull || root.pulled || !root.can-toggle {
            return;
        }
        root.pulling = dy > 8px;
        root.progress = root.pulling ? clamp(dy / root.pull-distance, 0, 1) : 0;
        if root.progress >= 1 {
            // The completed circle fades out (`pulled`) while the button settles back.
            root.pulled = true;
            root.pulling = false;
            AppState.haptic();
            AppState.toggle-connection();
        }
    }

    function pull-end() {
        root.pulling = false;
        root.progress = 0;
    }

    // Behind the content, so a pull can start on any empty part of the panel.
    if root.pull: TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.pull-start();
            } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                root.pull-end();
            }
        }
        moved => { root.pull-to(self.mouse-y - self.pressed-y); }
    }

    VerticalLayout {
        alignment: center;
        padding: 24px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 12px;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: root.size + 48px;
                height: root.size + 48px;

                // Soft static glow behind the button, in the state's color.
                Rectangle {
                    width: root.disc * 2.2;
                    height: self.width;
                    background: @radial-gradient(circle, root.tint.transparentize(root.connected ? 84% : root.busy ? 88% : 95%) 0%, transparent 70%);
                }

                // Halo: breathes while busy, steady glow when connected.
                Rectangle {
                    width: root.size * (1.08 + 0.14 * root.wave);
                    height: self.width;
                    border-radius: self.width / 2;
                    background: root.tint.transparentize(root.busy ? 0.75 + 0.15 * root.wave : root.connected ? 0.82 : 1);
                    animate background { duration: 250ms; }
                }

                // Spinning quarter arc while connecting / disconnecting. The endpoints are computed
                // from the clock (rather than rotating the element) so it works on every renderer.
                if root.busy: Path {
                    property <angle> start: animation-tick() / 0.9s * 360deg;
                    width: root.size + 30px;
                    height: root.size + 30px;
                    viewbox-width: 100;
                    viewbox-height: 100;
                    commands: "M " + (50 + 48 * cos(self.start)) + " " + (50 + 48 * sin(self.start))
                        + " A 48 48 0 0 1 " + (50 + 48 * cos(self.start + 90deg)) + " " + (50 + 48 * sin(self.start + 90deg));
                    stroke: root.tint;
                    stroke-width: 3px;
                }

                // Pull to connect: a faint track, and the arc that fills it clockwise from the top.
                if root.pull: Path {
                    width: root.disc + 30px;
                    height: root.disc + 30px;
                    viewbox-width: 100;
                    viewbox-height: 100;
                    commands: "M 50 2 A 48 48 0 0 1 50 98 A 48 48 0 0 1 50 2";
                    stroke: Theme.border-strong;
                    stroke-width: 3px;
                    opacity: root.pulling ? 0.6 : 0;
                    animate opacity { duration: 150ms; }
                }

                if root.pull && root.progress > 0.005: Path {
                    property <angle> end: -90deg + root.progress * 360deg;
                    width: root.disc + 30px;
                    height: root.disc + 30px;
                    viewbox-width: 100;
                    viewbox-height: 100;
                    // Two arcs past halfway: one SVG arc can't draw a whole circle.
                    commands: "M 50 2 A 48 48 0 0 1 "
                        + (root.progress > 0.5 ? "50 98 A 48 48 0 0 1 " : "")
                        + (50 + 48 * cos(self.end)) + " " + (50 + 48 * sin(self.end));
                    stroke: root.connected ? Theme.text-muted : Theme.accent;
                    stroke-width: 3px;
                    opacity: root.pulled ? 0 : 1;
                    animate opacity { duration: 250ms; }
                }

                ring := Rectangle {
                    width: root.disc;
                    height: root.disc;
                    border-radius: self.width / 2;
                    border-width: 2px;
                    border-color: root.ring-color;
                    animate border-color { duration: 250ms; }

                    Rectangle {
                        width: root.disc * (0.84 + 0.06 * root.grow - 0.12 * root.press);
                        height: self.width;
                        border-radius: self.width / 2;
                        // Lit when connected, a dark raised disc otherwise. Solid colors: the software
                        // renderer draws gradients without the rounded corners.
                        background: root.connected ? Theme.connected : touch.has-hover ? Theme.surface-hover : Theme.surface-raised;
                        animate background { duration: 250ms; }
                        border-width: root.connected ? 0px : 1px;
                        border-color: Theme.border-strong;

                        Image {
                            source: @image-url("../../assets/icons/MdiPowerStandby.svg");
                            width: parent.width / (2.2 - 0.3 * root.grow);
                            height: self.width;
                            colorize: root.connected ? Theme.on-accent
                                : root.busy ? Theme.connecting
                                : touch.has-hover ? Theme.accent : Theme.text-muted;
                        }
                    }

                    touch := TouchArea {
                        enabled: root.can-toggle;
                        mouse-cursor: self.enabled ? pointer : default;
                        // A pull can start on the button too; then lifting the finger isn't a tap.
                        clicked => {
                            if !root.dragged {
                                AppState.toggle-connection();
                            }
                        }
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down {
                                root.pull-start();
                            } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                                root.pull-end();
                            }
                        }
                        moved => { root.pull-to(self.mouse-y - self.pressed-y); }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 2px;

            Text {
                text: AppState.cancelling ? "Cancelling…"
                    : root.state == ConnectionState.connecting ? "Connecting…"
                    : root.state == ConnectionState.disconnecting ? "Disconnecting…"
                    : root.connected ? "Connected" : "Disconnected";
                font-size: 24px;
                font-weight: 800;
                horizontal-alignment: center;
                color: root.connected ? Theme.connected : root.busy ? Theme.connecting : Theme.text;
            }

            Text {
                text: root.connected && AppState.proxy-address != "" ? "Proxy on " + AppState.proxy-address + " · " + AppState.uptime
                    : root.connected ? AppState.uptime
                    : root.state == ConnectionState.connecting && !AppState.cancelling ? "Tap again to cancel"
                    : root.pull && root.state == ConnectionState.disconnected ? "Tap or pull down to connect"
                    : "";
                font-size: 12px;
                horizontal-alignment: center;
                color: Theme.text-muted;
            }
        }

        // How traffic reaches the VPN. Switching while connected reconnects.
        TabBar {
            height: 32px;
            font-size: 12px;
            // Same values as `MODES` in app.rs.
            tabs: root.system-proxy ? ["Tunnel", "System proxy", "Proxy only"] : ["Tunnel", "Proxy only"];
            values: root.system-proxy ? [0, 1, 2] : [0, 2];
            current <=> AppState.mode;
            enabled: !root.busy;
            changed => { AppState.mode-changed(); }
        }

        // Speeds and totals of this connection.
        Rectangle {
            height: 48px;
            border-radius: 12px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 12px;

                TrafficStat {
                    horizontal-stretch: 1;
                    icon: @image-url("../../assets/icons/MdiArrowDown.svg");
                    tint: Theme.accent;
                    label: "Download";
                    speed: AppState.download-speed;
                    total: AppState.download-total;
                    live: root.connected && AppState.traffic-known;
                }

                VerticalLayout {
                    padding-top: 10px;
                    padding-bottom: 10px;
                    Rectangle {
                        width: 1px;
                        background: Theme.border;
                    }
                }

                TrafficStat {
                    horizontal-stretch: 1;
                    icon: @image-url("../../assets/icons/MdiArrowUp.svg");
                    tint: Theme.connected;
                    label: "Upload";
                    speed: AppState.upload-speed;
                    total: AppState.upload-total;
                    live: root.connected && AppState.traffic-known;
                }
            }
        }

        // The selected config; clicking it jumps to the list.
        Rectangle {
            height: 54px;
            border-radius: 12px;
            background: card-touch.has-hover ? Theme.surface-raised : Theme.surface;
            border-width: 1px;
            border-color: card-touch.has-hover ? Theme.border-strong : Theme.border;

            card-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open-configs(); }
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;

                if AppState.selected-id >= 0: VerticalLayout {
                    alignment: center;
                    ProtocolBadge { protocol: AppState.selected-protocol; }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 1px;

                    Text {
                        text: AppState.selected-id >= 0 ? AppState.selected-name : "No config selected";
                        font-size: 13px;
                        font-weight: 600;
                        overflow: elide;
                    }

                    Text {
                        text: AppState.selected-id >= 0 ? AppState.selected-source : "Pick one in the Configs tab";
                        font-size: 11px;
                        color: Theme.text-muted;
                        overflow: elide;
                    }
                }
            }
        }

        // A transport plugin for the selected config (when one is installed and fits).
        if AppState.transport-available && AppState.transports.length > 1: HorizontalLayout {
            spacing: 8px;

            Text {
                text: "Transport";
                font-size: 12px;
                color: Theme.text-muted;
                vertical-alignment: center;
            }

            ComboBox {
                horizontal-stretch: 1;
                min-width: 60px;
                model: AppState.transports;
                current-index <=> AppState.selected-transport;
                enabled: !root.busy;
                selected => { AppState.transport-changed(); }
            }

            if AppState.transport-has-fields && AppState.selected-transport > 0: VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Settings";
                    enabled: !root.busy;
                    clicked => { AppState.edit-transport(); }
                }
            }
        }

        // The selected engine-plugin config's settings.
        if AppState.plugin-config-editable: HorizontalLayout {
            spacing: 8px;

            Text {
                horizontal-stretch: 1;
                text: "Plugin config";
                font-size: 12px;
                color: Theme.text-muted;
                vertical-alignment: center;
            }

            PillButton {
                text: "Settings";
                enabled: !root.busy;
                clicked => { AppState.edit-plugin-config(); }
            }
        }

        if AppState.error != "": Text {
            text: AppState.error;
            font-size: 11px;
            color: Theme.danger;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
}
