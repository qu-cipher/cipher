import { ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { AppState, ConnectionState } from "../state.slint";
import { PillButton, Toggle } from "../components/buttons.slint";
import { RuleItem } from "../components/rule-item.slint";

component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 6px;

    Text {
        text: root.title;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.8px;
        color: Theme.text-faint;
    }

    Rectangle {
        border-radius: 12px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;

        VerticalLayout {
            padding: 12px;
            spacing: 10px;
            @children
        }
    }
}

component Row inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 10px;

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;

        Text {
            text: root.label;
            font-size: 13px;
        }

        if root.hint != "": Text {
            text: root.hint;
            font-size: 10px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
    }

    @children
}

export component SettingsPanel inherits ScrollView {
    private property <string> github-url: "https://github.com/qu-cipher/cipher";
    private property <string> telegram-url: "https://t.me/q1tumc";

    VerticalLayout {
        spacing: 14px;
        padding-right: 8px;

        Section {
            title: "ENGINES";

            Row {
                label: "sing-box";
                hint: AppState.singbox-status;

                if !AppState.singbox-installed: VerticalLayout {
                    alignment: center;
                    PillButton {
                        text: AppState.engine-busy ? "Downloading…" : "Download";
                        primary: true;
                        // Files of a running engine can't be replaced.
                        enabled: !AppState.engine-busy && AppState.connection == ConnectionState.disconnected;
                        clicked => { AppState.install-singbox(); }
                    }
                }
            }

            Row {
                label: "Xray";
                hint: AppState.xray-status;

                if !AppState.xray-installed: VerticalLayout {
                    alignment: center;
                    PillButton {
                        text: AppState.xray-busy ? "Downloading…" : "Download";
                        primary: true;
                        enabled: !AppState.xray-busy && AppState.connection == ConnectionState.disconnected;
                        clicked => { AppState.install-xray(); }
                    }
                }
            }

            Row {
                label: "Core";
                hint: "Runs VLESS, VMess, Trojan and Shadowsocks configs. XHTTP, mKCP and VLESS encryption always use Xray.";
                VerticalLayout {
                    alignment: center;
                    ComboBox {
                        width: 110px;
                        model: AppState.cores;
                        current-index <=> AppState.core;
                        selected => { AppState.settings-changed(); }
                    }
                }
            }

            Row {
                label: "OpenVPN";
                hint: AppState.openvpn-status;
            }

            Row {
                label: "Psiphon";
                hint: AppState.psiphon-status;

                if !AppState.psiphon-installed: VerticalLayout {
                    alignment: center;
                    PillButton {
                        text: AppState.psiphon-busy ? "Downloading…" : "Download";
                        primary: true;
                        enabled: !AppState.psiphon-busy && AppState.connection == ConnectionState.disconnected;
                        clicked => { AppState.install-psiphon(); }
                    }
                }
            }
        }

        Section {
            title: "ROUTING";

            Row {
                label: "Bypass LAN";
                hint: "Local network and private addresses skip the tunnel.";
                Toggle {
                    checked <=> AppState.bypass-lan;
                    toggled => { AppState.settings-changed(); }
                }
            }

            Row {
                label: "Default route";
                hint: "Where traffic no rule matches goes. Direct: only matching traffic uses the VPN.";
                VerticalLayout {
                    alignment: center;
                    ComboBox {
                        width: 110px;
                        model: AppState.route-defaults;
                        current-index <=> AppState.route-default;
                        selected => { AppState.settings-changed(); }
                    }
                }
            }

            for preset[i] in AppState.presets: Row {
                label: preset.name;
                hint: preset.hint;
                Toggle {
                    checked: preset.enabled;
                    toggled => { AppState.toggle-preset(i); }
                }
            }

            Row {
                label: "Rules";
                hint: "Domains, IPs, ports, apps and geo lists. Checked top to bottom before the presets; the first match wins.";
                VerticalLayout {
                    alignment: center;
                    PillButton {
                        text: "Add rule";
                        icon: @image-url("../../assets/icons/MdiPlus.svg");
                        clicked => { AppState.edit-rule(-1); }
                    }
                }
            }

            for rule[i] in AppState.rules: RuleItem {
                data: rule;
                first: i == 0;
                last: i == AppState.rules.length - 1;
                toggled => { AppState.toggle-rule(i); }
                edit => { AppState.edit-rule(i); }
                move(delta) => { AppState.move-rule(i, delta); }
                remove => { AppState.remove-rule(i); }
            }

            Text {
                text: "Routing applies to sing-box configs; OpenVPN ignores it. Geo lists download through the VPN on connect.";
                font-size: 10px;
                color: Theme.text-faint;
                wrap: word-wrap;
            }
        }

        Section {
            title: "ANTI-DPI";

            Row {
                label: "Fragment TLS hello";
                hint: "Splits the TLS handshake into small, delayed pieces so filters can't read the server name. VLESS, VMess, Trojan and AnyTLS over TCP.";
                Toggle {
                    checked <=> AppState.tls-fragment;
                    toggled => { AppState.settings-changed(); }
                }
            }

            Row {
                label: "UDP noise";
                hint: "Sends a few random packets before connecting. mKCP configs (Xray).";
                Toggle {
                    checked <=> AppState.udp-noise;
                    toggled => { AppState.settings-changed(); }
                }
            }
        }

        Section {
            title: "PROXY";

            Row {
                label: "Proxy port";
                hint: "SOCKS5 / HTTP on 127.0.0.1, used by System proxy and Proxy only.";
                LineEdit {
                    width: 80px;
                    input-type: number;
                    placeholder-text: "2080";
                    text <=> AppState.proxy-port;
                    edited => { AppState.settings-changed(); }
                }
            }

            Row {
                label: "Proxy in Tunnel mode";
                hint: "Also serve the local proxy while tunneling.";
                Toggle {
                    checked <=> AppState.tunnel-proxy;
                    toggled => { AppState.settings-changed(); }
                }
            }
        }

        Section {
            title: "DNS";

            Row {
                label: "Remote";
                hint: "DNS-over-HTTPS through the tunnel.";
                LineEdit {
                    width: 160px;
                    placeholder-text: "1.1.1.1";
                    text <=> AppState.dns-remote;
                    edited => { AppState.settings-changed(); }
                }
            }

            Row {
                label: "Direct";
                hint: "Plain DNS that resolves server addresses.";
                LineEdit {
                    width: 160px;
                    placeholder-text: "8.8.8.8";
                    text <=> AppState.dns-direct;
                    edited => { AppState.settings-changed(); }
                }
            }
        }

        Section {
            title: "LOGS";

            Row {
                label: "Log level";
                ComboBox {
                    width: 110px;
                    model: AppState.log-levels;
                    current-index <=> AppState.log-level;
                    selected => { AppState.settings-changed(); }
                }
            }

            Row {
                label: "Data folder";
                hint: AppState.data-dir;
                PillButton {
                    text: "Open";
                    clicked => { AppState.open-data-dir(); }
                }
            }
        }

        Section {
            title: "ABOUT";

            Row {
                label: "Version";
                Text {
                    vertical-alignment: center;
                    text: AppState.app-version;
                    font-size: 13px;
                    color: Theme.text-muted;
                }
            }

            Row {
                label: "GitHub";
                hint: root.github-url;
                PillButton {
                    text: "Open";
                    clicked => { AppState.open-url(root.github-url); }
                }
            }

            Row {
                label: "Telegram channel";
                hint: root.telegram-url;
                PillButton {
                    text: "Open";
                    clicked => { AppState.open-url(root.telegram-url); }
                }
            }
        }

        Text {
            text: "Changes apply the next time you connect.";
            font-size: 11px;
            color: Theme.text-muted;
            horizontal-alignment: center;
        }
    }
}
