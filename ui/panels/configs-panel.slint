import { ListView, ComboBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { AppState } from "../state.slint";
import { IconButton, PillButton } from "../components/buttons.slint";
import { ConfigItem } from "../components/config-item.slint";
import { GroupHeader } from "../components/group-header.slint";

// Add / Import / Test.
component Actions inherits HorizontalLayout {
    spacing: 6px;
    alignment: start;

    PillButton {
        text: "Add";
        icon: @image-url("../../assets/icons/MdiPlus.svg");
        primary: true;
        clicked => {
            AppState.links-dialog-error = "";
            AppState.links-dialog-open = true;
        }
    }

    PillButton {
        text: "Import";
        icon: @image-url("../../assets/icons/MdiFileImport.svg");
        clicked => { AppState.import-files(); }
    }

    PillButton {
        text: AppState.testing ? "Testing…" : "Test";
        icon: @image-url("../../assets/icons/MdiFlash.svg");
        enabled: !AppState.testing && AppState.configs.length > 0;
        clicked => { AppState.test-latency(); }
    }
}

export component ConfigsPanel inherits VerticalLayout {
    // Narrow (phone) layout.
    in property <bool> compact;

    spacing: 8px;

    // ── Dragging a group ──
    // While a heading is dragged, a layer over the list shows just the headings (all folded);
    // the others slide aside to show where it will land.
    // A heading and the gap below it.
    private property <length> row-height: 33px;
    // The dragged group's index in `AppState.groups`; -1 = no drag.
    private property <int> drag-from: -1;
    // Where the pointer holds the heading.
    private property <length> grab;
    // The pointer, from the list's top.
    private property <length> drag-y;
    // The layer's own scroll, for when the headings don't fit.
    private property <length> scroll;
    private property <length> max-scroll: max(0px, AppState.groups.length * root.row-height - 5px - list-area.height);
    // Where it would land.
    private property <int> drag-to: clamp(round((root.drag-y - root.grab + root.scroll) / root.row-height), 0, AppState.groups.length - 1);

    function drop-group() {
        if root.drag-to != root.drag-from {
            AppState.place-group(AppState.groups[root.drag-from].name, root.drag-to);
        }
        root.drag-from = -1;
    }

    // Scrolls the layer while the pointer is near its top or bottom edge.
    Timer {
        interval: 16ms;
        running: root.drag-from >= 0
            && ((root.drag-y < 24px && root.scroll > 0) || (root.drag-y > list-area.height - 24px && root.scroll < root.max-scroll));
        triggered => { root.scroll = clamp(root.scroll + (root.drag-y < 24px ? -6px : 6px), 0, root.max-scroll); }
    }

    HorizontalLayout {
        spacing: 6px;

        ComboBox {
            horizontal-stretch: 1;
            model: AppState.filters;
            current-index <=> AppState.filter-index;
            selected => { AppState.filter-changed(self.current-index); }
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("../../assets/icons/MdiSortAscending.svg");
                icon-color: AppState.sort-by-latency ? Theme.accent : Theme.text-muted;
                hover-color: AppState.sort-by-latency ? Theme.accent : Theme.text;
                clicked => {
                    AppState.sort-by-latency = !AppState.sort-by-latency;
                    AppState.grouping-changed();
                }
            }
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("../../assets/icons/MdiFormatListGroup.svg");
                icon-color: AppState.group-configs ? Theme.accent : Theme.text-muted;
                hover-color: AppState.group-configs ? Theme.accent : Theme.text;
                clicked => {
                    AppState.group-configs = !AppState.group-configs;
                    AppState.grouping-changed();
                }
            }
        }

        if !root.compact: Actions { }
    }

    // Phone width: the buttons get their own row.
    if root.compact: Actions { }

    list-area := Rectangle {
    vertical-stretch: 1;

    if AppState.configs.length == 0: Text {
        text: AppState.config-total == 0
            ? "No configs yet.\nAdd share links, import a WireGuard / OpenVPN file,\nor add a subscription."
            : "Nothing in this list.";
        font-size: 13px;
        color: Theme.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if AppState.configs.length > 0: ListView {
        for config in AppState.configs: VerticalLayout {
            padding-bottom: 5px;

            if config.header: GroupHeader {
                data: config;
                clicked => { AppState.toggle-group(config.name); }
                move(step) => { AppState.move-group(config.name, step); }
                lift(offset, y) => {
                    root.grab = offset;
                    root.drag-y = y - list-area.absolute-position.y;
                    // Line the folded headings up so this one stays under the pointer.
                    root.scroll = clamp(config.index * root.row-height - (root.drag-y - offset), 0, root.max-scroll);
                    root.drag-from = config.index;
                }
                drag(y) => { root.drag-y = y - list-area.absolute-position.y; }
                drop => { root.drop-group(); }
                cancel => { root.drag-from = -1; }
            }

            if !config.header: ConfigItem {
                data: config;
                selected: config.id == AppState.selected-id;
                show-source: AppState.filter-index == 0;
                clicked => { AppState.select-config(config.id); }
                edit => { AppState.edit-config(config.id); }
                remove => { AppState.remove-config(config.id); }
            }
        }
    }

    if root.drag-from >= 0: Rectangle {
        background: Theme.background;
        clip: true;

        for group[i] in AppState.groups: GroupHeader {
            // Its place with the dragged one taken out and put back at `drag-to`.
            property <int> slot: i > root.drag-from && i <= root.drag-to ? i - 1
                : i < root.drag-from && i >= root.drag-to ? i + 1 : i;
            property <length> slot-y: self.slot * root.row-height;
            animate slot-y { duration: 120ms; easing: ease-out; }
            y: self.slot-y - root.scroll;
            width: parent.width;
            data: group;
            visible: i != root.drag-from;
        }

        // Where it will land.
        Rectangle {
            y: root.drag-to * root.row-height - root.scroll;
            height: 28px;
            border-radius: 8px;
            background: Theme.selected;
            border-width: 1px;
            border-color: Theme.accent.transparentize(60%);
        }

        GroupHeader {
            y: clamp(root.drag-y - root.grab, 0, parent.height - self.height);
            width: parent.width;
            data: AppState.groups[root.drag-from];
            lifted: true;
        }
    }
    }
}
