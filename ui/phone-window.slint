import "../assets/Geist.ttf";
import { Theme } from "theme.slint";
import { AppState, ConnectionState, ConfigData, EngineData, FieldData, PluginData, PresetData, RuleData, SubscriptionData } from "state.slint";
import { CompactLayout } from "compact-layout.slint";
import { Dialogs } from "dialogs.slint";

// Rust needs these to talk to the UI. The tray is desktop-only, but app.rs is shared.
export { Tray } from "tray.slint";
export { AppState, ConnectionState, ConfigData, EngineData, FieldData, PluginData, PresetData, RuleData, SubscriptionData }

// The phone window (Android): the compact layout, inside the safe area.
// Same name, properties and callbacks as the desktop `AppWindow`, so app.rs drives either one.
export component AppWindow inherits Window {
    title: "Cipher VPN Client";
    icon: @image-url("../assets/icon.svg");
    // Only for previewing on a desktop; on a phone the window fills the screen.
    preferred-width: 400px;
    preferred-height: 820px;
    default-font-family: "Geist";
    background: Theme.background;

    // Desktop title-bar actions; nothing calls them here.
    callback minimize_window();
    callback close_window();
    callback window_resized();

    VerticalLayout {
        padding-top: root.safe-area-insets.top;
        padding-left: root.safe-area-insets.left;
        padding-right: root.safe-area-insets.right;

        layout := CompactLayout {
            bottom-inset: root.safe-area-insets.bottom;
        }
    }

    Dialogs {
        top: root.safe-area-insets.top;
        bottom: max(root.safe-area-insets.bottom, root.virtual-keyboard-size.height);
        toast-bottom: max(root.safe-area-insets.bottom + layout.bar-height, root.virtual-keyboard-size.height);
    }
}
