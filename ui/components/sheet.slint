import { Theme } from "../theme.slint";

// A modal panel that slides up from the bottom, over a dimmed backdrop.
export component Sheet inherits Rectangle {
    in property <bool> open;
    in property <string> title;
    in property <length> sheet-height: 200px;

    callback dismiss();

    clip: true;

    // 0 = closed, 1 = open. Animating this instead of `y` keeps a closed sheet below the
    // bottom edge while the window resizes.
    private property <float> shown: root.open ? 1 : 0;
    animate shown { duration: 220ms; easing: ease-out; }

    Rectangle {
        background: #03060a;
        opacity: root.open ? 0.65 : 0;
        animate opacity { duration: 200ms; }
    }

    if root.open: TouchArea {
        clicked => { root.dismiss(); }
    }

    Rectangle {
        // Not wider than at the default window size.
        width: min(root.width - 32px, 800px);
        x: (root.width - self.width) / 2;
        y: root.height + 8px - (self.height + 24px) * root.shown;
        height: root.sheet-height;

        background: Theme.surface-raised;
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.border-strong;

        // Keeps clicks inside the sheet from reaching the backdrop.
        TouchArea { }

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            Text {
                text: root.title;
                font-size: 15px;
                font-weight: 700;
            }

            @children
        }
    }
}
