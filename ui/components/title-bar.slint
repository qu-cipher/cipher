import { Theme } from "../theme.slint";

component WindowButton inherits Rectangle {
    in property <image> icon;
    in property <color> hover-background: Theme.surface-hover;

    callback clicked();

    width: 30px;
    height: 22px;
    border-radius: 6px;
    background: touch.has-hover ? root.hover-background : transparent;

    Image {
        width: 16px;
        height: 16px;
        source: root.icon;
        colorize: touch.has-hover ? Theme.text : Theme.text-muted;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component TitleBar inherits Rectangle {
    in property <string> title;
    // Shows the restore icon instead of maximize.
    in property <bool> maximized;

    callback on_minimize_clicked();
    callback on_maximize_clicked();
    callback on_close_clicked();

    height: 30px;
    background: Theme.panel;

    WindowMoveArea {
        // Moving starts only once the pointer is dragged, so a double-click still gets here.
        TouchArea {
            double-clicked => { on_maximize_clicked() }
        }
    }

    // Bottom edge.
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 4px;
        spacing: 8px;

        // App mark.
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 3px;
                background: Theme.accent;
            }
        }

        Text {
            text: title;
            font-size: 12px;
            font-weight: 600;
            color: Theme.text-muted;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        HorizontalLayout {
            spacing: 2px;
            alignment: center;

            VerticalLayout {
                alignment: center;
                WindowButton {
                    icon: @image-url("../../assets/icons/MdiWindowMinimize.svg");
                    clicked => { on_minimize_clicked() }
                }
            }

            VerticalLayout {
                alignment: center;
                WindowButton {
                    icon: root.maximized ? @image-url("../../assets/icons/MdiWindowRestore.svg") : @image-url("../../assets/icons/MdiWindowMaximize.svg");
                    clicked => { on_maximize_clicked() }
                }
            }

            VerticalLayout {
                alignment: center;
                WindowButton {
                    icon: @image-url("../../assets/icons/MdiClose.svg");
                    hover-background: Theme.danger.transparentize(30%);
                    clicked => { on_close_clicked() }
                }
            }
        }
    }
}
