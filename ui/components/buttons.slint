import { Theme } from "../theme.slint";

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> size: 18px;
    in property <color> icon-color: Theme.text-muted;
    in property <color> hover-color: Theme.text;
    in property <bool> enabled: true;
    in property <bool> spinning;

    callback clicked();

    width: root.size + 10px;
    height: root.size + 10px;
    border-radius: self.height / 2;
    background: touch.has-hover && root.enabled ? Theme.surface-hover : transparent;

    Image {
        source: root.icon;
        width: root.size;
        height: root.size;
        colorize: !root.enabled ? Theme.text-muted.transparentize(50%) : touch.has-hover ? root.hover-color : root.icon-color;
        transform-rotation: root.spinning ? animation-tick() / 1s * 360deg : 0deg;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component PillButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> primary;
    in property <bool> danger;

    callback clicked();

    private property <color> fill: root.danger ? Theme.danger : root.primary ? Theme.accent : Theme.surface-raised;
    private property <color> ink: root.danger || root.primary ? Theme.on-accent : Theme.text;

    height: 28px;
    border-radius: self.height / 2;
    background: !root.enabled ? Theme.surface : touch.has-hover ? root.fill.brighter(root.primary || root.danger ? 12% : 25%) : root.fill;
    border-width: root.primary || root.danger ? 0px : 1px;
    border-color: Theme.border-strong;
    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;

        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 14px;
                height: 14px;
                colorize: root.enabled ? root.ink : Theme.text-faint;
            }
        }

        Text {
            text: root.text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            color: root.enabled ? root.ink : Theme.text-faint;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component ProtocolBadge inherits Rectangle {
    in property <string> protocol;

    width: label.preferred-width + 10px;
    height: 18px;
    border-radius: 5px;
    background: root.tint.transparentize(85%);
    border-width: 1px;
    border-color: root.tint.transparentize(70%);

    private property <color> tint: Theme.protocol-color(root.protocol);

    label := Text {
        text: root.protocol;
        color: root.tint;
        font-size: 10px;
        font-weight: 700;
    }
}

// On/off switch in the theme's colors (the Fluent `Switch` has its own fixed accent).
export component Toggle inherits Rectangle {
    in-out property <bool> checked;

    callback toggled();

    width: 38px;
    height: 22px;
    border-radius: self.height / 2;
    background: root.checked ? Theme.accent : Theme.surface-hover;
    border-width: 1px;
    border-color: root.checked ? Theme.accent : Theme.border-strong;
    animate background, border-color { duration: 120ms; }

    Rectangle {
        x: root.checked ? root.width - self.width - 4px : 4px;
        width: 14px;
        height: 14px;
        border-radius: self.height / 2;
        background: root.checked ? Theme.on-accent : Theme.text-muted;
        animate x { duration: 120ms; easing: ease-out; }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}
