import { Theme } from "../theme.slint";

export component TabBar inherits Rectangle {
    in property <[string]> tabs;
    in-out property <int> current;
    // What each tab sets `current` to; empty = its index. Lets a shorter tab list (phone) map onto
    // the same values as the full one.
    in property <[int]> values;
    in property <bool> enabled: true;
    in property <length> font-size: 13px;

    // Only for clicks, not for changes made from code.
    callback changed(int);

    height: 36px;
    border-radius: 10px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    opacity: root.enabled ? 1 : 0.5;

    HorizontalLayout {
        padding: 3px;
        spacing: 3px;

        for tab[i] in root.tabs: Rectangle {
            property <int> value: root.values.length > i ? root.values[i] : i;

            border-radius: 8px;
            background: self.value == root.current ? Theme.surface-hover : touch.has-hover ? Theme.surface-raised : transparent;
            border-width: self.value == root.current ? 1px : 0px;
            border-color: Theme.border-strong;
            animate background { duration: 120ms; }

            Text {
                text: tab;
                font-size: root.font-size;
                font-weight: parent.value == root.current ? 600 : 400;
                color: parent.value == root.current ? Theme.text : Theme.text-muted;
            }

            touch := TouchArea {
                enabled: root.enabled;
                mouse-cursor: root.enabled ? pointer : default;
                clicked => {
                    if parent.value != root.current {
                        root.current = parent.value;
                        root.changed(parent.value);
                    }
                }
            }
        }
    }
}
